<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plain JUnit 5 tests for the plugin's Eclipse-free classes.

  There are no copies of production code here: the main sources are the plugin's own src/ folder,
  restricted to the classes below. Those classes must not use Eclipse or ADT APIs; if one starts to,
  this module stops compiling, which is the intended signal to move the new logic into core/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.consetto.adt</groupId>
    <artifactId>cloudalmlink-tests</artifactId>
    <version>0.9.5-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Cloud ALM Link Tests</name>
    <description>Unit tests for Cloud ALM Link Eclipse Plugin</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <gson.version>2.12.1</gson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The plugin gets Gson from the Eclipse target platform; same version as in the MANIFEST. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>../com.consetto.adt.cloudalmlink/src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <includes>
                                <include>com/consetto/adt/cloudalmlink/CloudAlmLinkConstants.java</include>
                                <include>com/consetto/adt/cloudalmlink/core/**/*.java</include>
                                <include>com/consetto/adt/cloudalmlink/model/BearerToken.java</include>
                                <include>com/consetto/adt/cloudalmlink/model/CloudAlmConfig.java</include>
                                <include>com/consetto/adt/cloudalmlink/model/CloudAlmItemType.java</include>
                                <include>com/consetto/adt/cloudalmlink/model/FeatureElement.java</include>
                                <include>com/consetto/adt/cloudalmlink/model/VersionElement.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
